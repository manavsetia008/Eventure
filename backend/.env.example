# ─────────────────────────────────────────────────────────────
# Eventure — backend environment
# Copy this file to .env and fill in only what you need.
# Third-party provider keys are optional for local development; production database and
# signing-key requirements are documented in DEPLOYMENT_ENV.md. The app has safe local fallbacks.
# ─────────────────────────────────────────────────────────────

# Required in production. Any long random string. Free.
SECRET_KEY= # Generate a unique random value of at least 32 characters for production.

APP_ENV=development

# SQLite by default (backend/eventure.db). Set a Supabase Postgres URL for production.
# Example: DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# DATABASE_URL=

# Frontend origin(s) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Times for calendar entries and push alerts. Free.
TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173

# Public origin of the app. Google sign-in builds its callback from this:
# APP_BASE_URL/auth/google/callback. Use http://localhost:5173 in development and your live
# domain in production (must match the redirect URI in the Google Cloud console).
APP_BASE_URL=http://localhost:5173

# ── Gemini LLM Network (Chatbot & Hackathon Submission Box) ──
# Free: https://aistudio.google.com/apikey (15 req/min free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Sarvam AI Indic Engine (Hinglish notice extraction, Indic translation & Bulbul TTS) ──
# Get a key at https://dashboard.sarvam.ai — free credits, then paid.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3

# ── Real-Time Hackathon Suggestions (Google Custom Search API) ──
# 100 free queries/day: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Neo4j Graph Database (Optional) ──
# Free cloud instance at https://neo4j.com/cloud/aura-free/ or self-hosted Docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Real travel times (optional) ──
# Uses OpenStreetMap Nominatim for free if GOOGLE_MAPS_API_KEY is not set.
GOOGLE_MAPS_API_KEY=
GEOCODE_OSM=1

# ── Google Calendar sync and "Continue with Google" sign-in (optional) ──
# OAuth client from Google Cloud Console (free). Leave blank to skip both features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# ── Browser and phone push reminders (optional, free) ──
# Generate a key pair with:  python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Email forwarding (optional, free) ──
INBOX_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=5
INBOUND_SECRET=

# ── Background jobs (optional, free) ──
AUTO_CREATE_DB=1
ENABLE_SCHEDULER=1
REMINDER_INTERVAL_MINUTES=15

# ── Optional email reminders (free / paid, provider dependent) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eventure@example.com

# Set to 1 when running behind nginx / Render / Railway
# TRUST_PROXY=1
