# ─────────────────────────────────────────────────────────────
# Eventure — backend environment
# Copy this file to .env and fill in only what you need.
# Every key is optional; the app runs with none of them set.
# ─────────────────────────────────────────────────────────────

# Required in production. Any long random string. Free.
SECRET_KEY=change-me

# SQLite by default (backend/eventure.db). Set a Postgres URL for production.
# Example: DATABASE_URL=postgresql://user:pass@host:5432/eventure
# DATABASE_URL=

# Frontend origin(s) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Times for calendar entries and push alerts. Free.
TIMEZONE=Asia/Kolkata
# Where Google OAuth redirects back to after connecting.
FRONTEND_URL=http://localhost:5173

# Public origin of the app. Google sign-in builds its callback from this:
# APP_BASE_URL/auth/google/callback. Use http://localhost:5173 in development and your live
# domain in production (must match the redirect URI in the Google Cloud console).
APP_BASE_URL=http://localhost:5173

# ── Notice extraction, poster OCR and Indic translation (optional) ──
# Get a key at https://dashboard.sarvam.ai — free credits, then paid.
# Without it the app uses a built-in rule-based parser and offers "Fill in manually".
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3

# ── Real travel times (optional) ──
# Google Distance Matrix key from Google Cloud Console (paid, has free credit).
# Without it, travel time is estimated from straight-line distance.
GOOGLE_MAPS_API_KEY=

# ── Google Calendar sync and "Continue with Google" sign-in (optional) ──
# OAuth client from Google Cloud Console (free). Leave blank to skip both features.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application.
# The same client powers sign-in, so add both redirect URIs (see README > "Google sign-in setup").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# ── Browser and phone push reminders (optional, free) ──
# Generate a key pair with:  python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Email forwarding (optional, free) ──
# A mailbox students forward event emails to (Gmail plus-addressing works).
# Set INBOX_ADDRESS to show the forwarding address in the Inbox UI.
# Either poll the mailbox over IMAP, or point your mail provider's inbound
# webhook at /api/inbound/email and set INBOUND_SECRET.
INBOX_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=5
INBOUND_SECRET=

# ── Background jobs (optional, free) ──
# Set AUTO_CREATE_DB=0 once you manage the schema with Flask-Migrate.
AUTO_CREATE_DB=1
# Deadline reminders and how often they are checked.
ENABLE_SCHEDULER=1
REMINDER_INTERVAL_MINUTES=15

# ── Optional email reminders (free / paid, provider dependent) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eventure@example.com

# Set to 1 when running behind nginx / Render / Railway so client IPs and
# https are read from proxy headers.
# TRUST_PROXY=1
