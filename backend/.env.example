# Copy to .env and edit. Everything here is optional for a local demo.
SECRET_KEY=change-me
# SQLite is the default. For PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgresql://eventure:eventure@localhost:5432/eventure
CORS_ORIGINS=http://localhost:5173

# LLM extraction (without a key the app uses its built-in rule-based parser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Real travel times and venue geocoding (without a key travel time is estimated from distance)
GOOGLE_MAPS_API_KEY=

# Used for Google Calendar times and the redirect back to the app
TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173

# Google Calendar sync (see README: "Connect the extras")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback

# Browser and phone push alerts: run  python scripts/generate_vapid_keys.py  and paste the two lines
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email forwarding: a dedicated mailbox students forward event emails to (Gmail plus-addressing works)
INBOX_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_MINUTES=5
# Or use a mail provider's inbound webhook instead (send header X-Inbound-Secret)
INBOUND_SECRET=

# Set to 0 once you manage the schema with Flask-Migrate
AUTO_CREATE_DB=1

# Deadline reminders
ENABLE_SCHEDULER=1
REMINDER_INTERVAL_MINUTES=15
# Optional email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=eventure@example.com
