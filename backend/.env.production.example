# ==============================================================================
# EVENTURE PRODUCTION ENVIRONMENT CONFIGURATION (RENDER DEPLOYMENT)
# Copy these values into your Render Dashboard (Environment tab) for eventure-gdx5.
# ==============================================================================

# Core Application Security
SECRET_KEY=eventure-production-super-secret-key-32-bytes-long!
CORS_ORIGINS=http://localhost:5173,https://eventure-gdx5.onrender.com,https://*.vercel.app,*
TRUST_PROXY=1

# Timezone & URLs
TIMEZONE=Asia/Kolkata
FRONTEND_URL=https://eventure-gdx5.onrender.com
APP_BASE_URL=https://eventure-gdx5.onrender.com

# Gemini LLM Architecture (Chatbot + Hackathon Submission Box)
# Add your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI Indic Engine (Voice Calls, Hinglish extraction, translation & TTS)
# Add your Sarvam API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TTS_MODEL=bulbul:v3

# OpenStreetMap Nominatim Geocoding & Travel (100% Free - No Google Maps Key Needed)
GOOGLE_MAPS_API_KEY=
GEOCODE_OSM=1

# Real-time Hackathon Suggestions (Google Custom Search API / Free Live Web Search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Neo4j Graph Database
# Free cloud AuraDB: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=eventure-graph-pass

# Google Calendar sync and "Continue with Google" sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://eventure-gdx5.onrender.com/api/google/callback

# Web Push Notification VAPID Keys (Generate with backend/scripts/generate_vapid_keys.py)
VAPID_PUBLIC_KEY=BHWmvmgcfRafL9w56ZLAnxR7ZJG5AD6EGG9H0BAxOZwxQA20aniNzfa0A12D2zXAr8ye3zT22ZKAIiNqTKUHyWw
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:manavsetia008@gmail.com

# Inbound Webhooks & Email Processing
INBOX_ADDRESS=noil36l4m3cdsgo5@ethereal.email
IMAP_HOST=imap.ethereal.email
IMAP_PORT=993
IMAP_USER=noil36l4m3cdsgo5@ethereal.email
IMAP_PASSWORD=
IMAP_POLL_MINUTES=5
INBOUND_SECRET=

# Database Auto-creation & Reminder Background Scheduler
AUTO_CREATE_DB=1
ENABLE_SCHEDULER=1
REMINDER_INTERVAL_MINUTES=15

# SMTP Email Configuration (Free Ethereal Email test mailbox at https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=noil36l4m3cdsgo5@ethereal.email
SMTP_PASSWORD=
SMTP_FROM=noreply@eventure.app
